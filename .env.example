# SpanBarn configuration
# Copy to /etc/spanbarn/spanbarn.conf or ~/.config/spanbarn/spanbarn.conf
# Environment variables always override file values.

# -- Server -------------------------------------------------------------------

# Address to listen on (default: :8080)
SPANBARN_ADDR=:8080

# Public-facing URL used in setup pages and SDK links
SPANBARN_PUBLIC_URL=https://example.com

# -- Authentication ------------------------------------------------------------

# HMAC secret for session tokens -- generate with: openssl rand -hex 32
# Without this, sessions will not survive restarts.
SPANBARN_SESSION_SECRET=

# Admin user credentials (choose one: plaintext OR pre-hashed bcrypt)
SPANBARN_ADMIN_USERNAME=admin
SPANBARN_ADMIN_PASSWORD=changeme
# SPANBARN_ADMIN_PASSWORD_BCRYPT=$2b$12$...

# Session lifetime in seconds (default: 43200 = 12 hours)
# SPANBARN_SESSION_TTL_SECONDS=43200

# -- Ingest API key ------------------------------------------------------------

# Static ingest API key accepted server-wide (use DB-managed keys for per-project)
# SPANBARN_API_KEY=your-plaintext-key

# SHA-256 hex of the API key (more secure -- plaintext never stored)
# SPANBARN_API_KEY_SHA256=

# -- CORS ----------------------------------------------------------------------

# Comma-separated list of allowed origins (* to allow all)
# SPANBARN_ALLOWED_ORIGINS=https://app.example.com,https://example.com

# -- Storage -------------------------------------------------------------------

# SQLite database path (default: .data/spanbarn.db)
# SPANBARN_DB_PATH=.data/spanbarn.db

# Spool directory for ingest write-ahead log (default: .data/spool)
# SPANBARN_SPOOL_DIR=.data/spool

# Maximum spool size in bytes before rotation (default: unlimited)
# SPANBARN_MAX_SPOOL_BYTES=268435456

# Maximum ingest request body size in bytes (default: 4194304 = 4 MiB)
# SPANBARN_MAX_BODY_BYTES=4194304

# -- Retention -----------------------------------------------------------------

# Hours to keep full-fidelity spans (default: 4)
# SPANBARN_RETENTION_FULL_HOURS=4

# Days to keep aggregated metrics (default: 365)
# SPANBARN_RETENTION_AGGREGATED_DAYS=365

# Days to keep error/slow span samples (default: 30)
# SPANBARN_RETENTION_ERROR_DAYS=30

# Threshold in ms above which a span is considered "slow" and sampled (default: 1000)
# SPANBARN_SLOW_THRESHOLD_MS=1000

# Aggregation bucket size (default: 1m). Supported: 1m, 5m, 15m, 1h
# SPANBARN_AGGREGATION_INTERVAL=1m

# -- Self-instrumentation (dogfooding) -----------------------------------------

SPANBARN_SELF_ENDPOINT=https://spanbarn.wiebe.xyz
# SPANBARN_SELF_API_KEY=<set via SOPS secret>
SPANBARN_ENVIRONMENT=production

# -- Rate limiting -------------------------------------------------------------

# SPANBARN_LOGIN_RATE_PER_MINUTE=20
# SPANBARN_INGEST_RATE_PER_MINUTE=500
# SPANBARN_API_RATE_PER_MINUTE=300

# -- Metrics -------------------------------------------------------------------

# Bearer token to protect /metrics endpoint (optional)
# SPANBARN_METRICS_TOKEN=
