:8080 {
	handle /api/* {
		reverse_proxy service:8080
	}

	handle /v1/* {
		reverse_proxy service:8080
	}

	# Vite names these files by content hash, so a file never changes and can be
	# cached for good. A chunk that a deploy removed must answer 404: falling
	# back to index.html would hand HTML to a script import and hide the miss.
	handle /assets/* {
		root * /srv
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html and every other route must be revalidated on each load. Without
	# a Cache-Control header the browser reuses a cached index.html for a while,
	# so the reload that StaleChunk triggers after a deploy fetched the old index
	# again, which still pointed at the removed chunks.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
