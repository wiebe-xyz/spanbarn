apiVersion: v1
kind: Secret
metadata:
  name: spanbarn-secrets
  namespace: spanbarn-staging
type: Opaque
stringData:
  SPANBARN_OIDC_ORGANIZATION_ID: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  SPANBARN_API_KEY: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  SPANBARN_BUGBARN_API_KEY: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  SPANBARN_SELF_API_KEY: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  SPANBARN_ENVIRONMENT: staging
  E2E_OIDC_EMAIL: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  E2E_OIDC_PASSWORD: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
