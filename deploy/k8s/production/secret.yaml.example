apiVersion: v1
kind: Secret
metadata:
  name: spanbarn-secrets
  namespace: spanbarn-production
type: Opaque
stringData:
  SPANBARN_API_KEY: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  SPANBARN_SESSION_SECRET: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  SPANBARN_BUGBARN_API_KEY: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  SPANBARN_SELF_API_KEY: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  SPANBARN_ENVIRONMENT: production
  # Used by the settings-snapshot CronJob to push disaster-recovery snapshots
  # to s3://barn-backups/spanbarn/settings-snapshots/production/ (shared R2
  # backups bucket; see deploy/docs/disaster-recovery.md).
  SPANBARN_SNAPSHOT_ACCESS_KEY_ID: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
  SPANBARN_SNAPSHOT_SECRET_ACCESS_KEY: REPLACE_WITH_SOPS_ENCRYPTED_VALUE
